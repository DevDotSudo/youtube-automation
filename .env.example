# ==============================================================================
# Pixazo AI Image Generation Gateway
# ==============================================================================
# Paste your Pixazo API key below.
# Get your API key from your Pixazo dashboard: https://www.pixazo.ai/
PIXAZO_API_KEY=

# Default model: flux-1-schnell (recommended for speed and prompt fidelity)
PIXAZO_MODEL=flux-1-schnell
PIXAZO_CONCURRENCY=5

# ==============================================================================
# Agnes AI (Primary Text-to-Image Prompt Provider)
# ==============================================================================
# Generates detailed text-to-image prompts from video scripts
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ==============================================================================
# Groq (Fallback Text-to-Image Prompt Provider)
# ==============================================================================
# Fallback prompt generator if Agnes AI is unavailable
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
