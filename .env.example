PIXAZO_API_KEY=

# Default model: flux-schnell (recommended for speed and prompt fidelity)
# Available models on gateway.pixazo.ai:
# - flux-schnell (Ultra fast, 2-4s latency)
# - flux-dev     (High detail and creative precision)
# - flux-pro     (Production grade high resolution)
# - stable-diffusion-3-5 (SD 3.5 Large)
PIXAZO_MODEL=flux-1-schnell
